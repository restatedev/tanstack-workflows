{
  "name": "@restatedev/tanstack-workflows",
  "version": "0.0.0",
  "description": "Run TanStack workflows on Restate",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@restatedev/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check:types": "tsc",
    "check:exports": "attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@restatedev/restate-sdk": "catalog:",
    "@tanstack/workflow-core": "^0.0.4"
  },
  "devDependencies": {
    "@restatedev/restate-sdk": "catalog:",
    "@tanstack/workflow-core": "^0.0.4",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@restatedev/tanstack-workflows-interface": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restatedev/tanstack-workflows.git",
    "directory": "packages/libs/tanstack-workflows"
  },
  "homepage": "https://github.com/restatedev/tanstack-workflows#readme",
  "bugs": {
    "url": "https://github.com/restatedev/tanstack-workflows/issues"
  },
  "author": "Restate Software, Inc.",
  "keywords": [
    "restate",
    "tanstack",
    "workflow",
    "durable-execution"
  ]
}
